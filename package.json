{
  "name": "tts-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline text-to-speech reader with synchronized word/sentence highlighting (Web Speech API).",
  "scripts": {
    "dev": "npm run pdf-assets && vite",
    "build": "npm run pdf-assets && vite build",
    "start": "npm run build && node scripts/serve.mjs --open",
    "serve": "node scripts/serve.mjs --open",
    "stop": "node scripts/stop.mjs",
    "preview": "vite preview --port 4173",
    "make-app": "bash scripts/make-app.sh",
    "pdf-assets": "node scripts/copy-pdf-assets.mjs",
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "vite": "^5.4.11"
  }
}
